from uuid import UUID

class DependencyGraph:
    def num_nodes(self) -> int: ...
    def order(
        self, required_nodes: set[UUID] | frozenset[UUID] | None = None
    ) -> list[UUID]: ...
    def get_all_required(self, nodes: set[UUID] | frozenset[UUID]) -> list[UUID]: ...

def make_dependency_graph(
    nodes: dict[UUID, set[UUID] | frozenset[UUID]],
) -> DependencyGraph: ...
